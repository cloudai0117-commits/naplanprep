# ─── LOCAL DEVELOPER ENVIRONMENT VARIABLES ───────────────────────────────────
# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored — never commit real secrets.
#
# Load with your IDE's run configuration, direnv, or:
#   export $(grep -v '^#' .env | xargs)
# ─────────────────────────────────────────────────────────────────────────────

# ── Stripe (TEST mode — from https://dashboard.stripe.com/test/apikeys) ──────
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Run `stripe listen --forward-to localhost:8080/v1/subscriptions/webhooks/stripe`
# and copy the whsec_... value the CLI prints.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_CLI_WEBHOOK_SECRET_HERE

# One-time Price IDs from https://dashboard.stripe.com/test/products
# These are NOT secrets — they are safe to share but must not be hardcoded in YAML.
STRIPE_ADVANCED_PRICE_ID=price_YOUR_ADVANCED_PRICE_ID
STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE_ID
